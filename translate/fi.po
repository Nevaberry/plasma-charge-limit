#, kde-format
msgid "Charge Limit"
msgstr "Latausraja"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Lataus päättyy tasolla %1 %"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Akkua, jonka latausrajaa voi säätää, ei löytynyt"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1 %"

#, kde-format
msgid "Stop charging at"
msgstr "Keskeytä lataus tasolla"

#, kde-format
msgid "Tips"
msgstr "Vinkit"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1 %"

#, kde-format
msgid "This update asks for your password once."
msgstr "Tämä päivitys pyytää salasanaasi kerran."

#, kde-format
msgid "The first change asks for your password once."
msgstr "Ensimmäinen muutos pyytää salasanaasi kerran."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Jos uusi raja ei tule voimaan, irrota laturi ja kytke se takaisin."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Voit pitää Latausrajan aina näkyvissä napsauttamalla ilmoitusalueen nuolta hiiren oikealla painikkeella, valitsemalla <b>Ilmoitusalueen asetukset...</b> ja asettamalla Latausrajalle <b>Näytä aina</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Akun varaus %1 %, latautuu"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Akun varaus %1 %, purkautuu"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Akun varaus %1 %, täyteen ladattu"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Akun varaus %1 %, ei lataudu"

#, kde-format
msgid "Battery at %1%"
msgstr "Akun varaus %1 %"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Latausrajan lukeminen epäonnistui."

#. TRANSLATORS: %1 is a terminal command; do not translate pkexec.
#, kde-format
msgid "pkexec is missing. Install it with your package manager. On Debian, run: %1"
msgstr "pkexec puuttuu. Asenna se paketinhallinnalla. Suorita Debianissa: %1"

#, kde-format
msgid "Could not change the charge limit."
msgstr "Latausrajan muuttaminen epäonnistui."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Vaihda akun latausrajaa yhdellä napsautuksella: 50, 80, 90 tai 100 %"
