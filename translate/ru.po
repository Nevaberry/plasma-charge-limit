#, kde-format
msgid "Charge Limit"
msgstr "Предел заряда"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Прекращает зарядку при %1%"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Батарея с настраиваемым пределом заряда не найдена"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "Stop charging at"
msgstr "Прекращать зарядку при"

#, kde-format
msgid "Tips"
msgstr "Советы"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "This update asks for your password once."
msgstr "После этого обновления потребуется ввести пароль один раз."

#, kde-format
msgid "The first change asks for your password once."
msgstr "При первом изменении потребуется ввести пароль один раз."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Если новый предел не применяется, отключите зарядное устройство и подключите его снова."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Чтобы Предел заряда всегда был виден, щёлкните правой кнопкой мыши по стрелке системного лотка, выберите <b>Настроить системный лоток...</b> и задайте для Предела заряда режим <b>Показывать всегда</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Заряд батареи: %1%, заряжается"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Заряд батареи: %1%, разряжается"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Заряд батареи: %1%, полностью заряжена"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Заряд батареи: %1%, не заряжается"

#, kde-format
msgid "Battery at %1%"
msgstr "Заряд батареи: %1%"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Не удалось прочитать предел заряда."

#. TRANSLATORS: %1 is a terminal command; do not translate pkexec.
#, kde-format
msgid "pkexec is missing. Install it with your package manager. On Debian, run: %1"
msgstr "pkexec отсутствует. Установите его с помощью менеджера пакетов. В Debian выполните: %1"

#, kde-format
msgid "Could not change the charge limit."
msgstr "Не удалось изменить предел заряда."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Меняйте предел заряда батареи одним щелчком: 50, 80, 90 или 100%"
