#, kde-format
msgid "Charge Limit"
msgstr "Limit ładowania"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Kończy ładowanie przy %1%"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Nie znaleziono baterii z regulowanym limitem ładowania"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "Stop charging at"
msgstr "Zakończ ładowanie przy"

#, kde-format
msgid "Tips"
msgstr "Wskazówki"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "This update asks for your password once."
msgstr "Ta aktualizacja poprosi o hasło tylko raz."

#, kde-format
msgid "The first change asks for your password once."
msgstr "Pierwsza zmiana poprosi o hasło tylko raz."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Jeśli nowy limit nie zacznie działać, odłącz ładowarkę i podłącz ją ponownie."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Aby Limit ładowania był zawsze widoczny, kliknij prawym przyciskiem myszy strzałkę tacki systemowej, wybierz <b>Konfiguruj tackę systemową...</b> i ustaw dla Limitu ładowania opcję <b>Zawsze widoczne</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Bateria: %1%, ładowanie"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Bateria: %1%, rozładowywanie"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Bateria: %1%, w pełni naładowana"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Bateria: %1%, bez ładowania"

#, kde-format
msgid "Battery at %1%"
msgstr "Bateria: %1%"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Nie można odczytać limitu ładowania."

#, kde-format
msgid "Could not change the charge limit."
msgstr "Nie można zmienić limitu ładowania."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Zmień limit ładowania baterii jednym kliknięciem: 50, 80, 90 lub 100%"
