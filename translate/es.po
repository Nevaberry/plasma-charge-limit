#, kde-format
msgid "Charge Limit"
msgstr "Límite de carga"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Detiene la carga al %1 %"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "No se ha encontrado ninguna batería con límite de carga ajustable"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1 %"

#, kde-format
msgid "Stop charging at"
msgstr "Detener la carga al"

#, kde-format
msgid "Tips"
msgstr "Consejos"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1 %"

#, kde-format
msgid "This update asks for your password once."
msgstr "Esta actualización solicita su contraseña una sola vez."

#, kde-format
msgid "The first change asks for your password once."
msgstr "El primer cambio solicita su contraseña una sola vez."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Si un nuevo límite no surte efecto, desconecte el cargador y vuelva a conectarlo."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Para mantener Límite de carga siempre visible, haga clic con el botón derecho en la flecha de la bandeja del sistema, elija <b>Configurar bandeja del sistema...</b> y establezca Límite de carga en <b>Mostrar siempre</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Batería al %1 %, cargando"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Batería al %1 %, descargando"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Batería al %1 %, completamente cargada"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Batería al %1 %, sin cargar"

#, kde-format
msgid "Battery at %1%"
msgstr "Batería al %1 %"

#, kde-format
msgid "Could not read the charge limit."
msgstr "No se ha podido leer el límite de carga."

#, kde-format
msgid "Could not change the charge limit."
msgstr "No se ha podido cambiar el límite de carga."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Cambie el límite de carga de la batería con un clic: 50, 80, 90 o 100 %"
