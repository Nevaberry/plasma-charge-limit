#, kde-format
msgid "Charge Limit"
msgstr "Ladegrenze"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Beendet das Laden bei %1 %"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Kein Akku mit einstellbarer Ladegrenze gefunden"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1 %"

#, kde-format
msgid "Stop charging at"
msgstr "Laden beenden bei"

#, kde-format
msgid "Tips"
msgstr "Tipps"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1 %"

#, kde-format
msgid "This update asks for your password once."
msgstr "Dieses Update fragt einmalig nach Ihrem Passwort."

#, kde-format
msgid "The first change asks for your password once."
msgstr "Bei der ersten Änderung wird einmalig Ihr Passwort abgefragt."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Falls eine neue Grenze nicht wirksam wird, trennen Sie das Ladegerät und schließen Sie es wieder an."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Damit Ladegrenze immer sichtbar bleibt, klicken Sie mit der rechten Maustaste auf den Pfeil im Systemabschnitt der Kontrollleiste, wählen Sie <b>Systemabschnitt der Kontrollleiste einrichten...</b> und stellen Sie Ladegrenze auf <b>Immer anzeigen</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Akku bei %1 %, wird geladen"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Akku bei %1 %, wird entladen"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Akku bei %1 %, vollständig geladen"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Akku bei %1 %, wird nicht geladen"

#, kde-format
msgid "Battery at %1%"
msgstr "Akku bei %1 %"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Die Ladegrenze konnte nicht gelesen werden."

#. TRANSLATORS: %1 is a terminal command; do not translate pkexec.
#, kde-format
msgid "pkexec is missing. Install it with your package manager. On Debian, run: %1"
msgstr "pkexec fehlt. Installieren Sie es mit Ihrer Paketverwaltung. Führen Sie unter Debian folgenden Befehl aus: %1"

#, kde-format
msgid "Could not change the charge limit."
msgstr "Die Ladegrenze konnte nicht geändert werden."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Die Ladegrenze des Akkus mit einem Klick ändern: 50, 80, 90 oder 100 %"
