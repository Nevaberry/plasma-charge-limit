#, kde-format
msgid "Charge Limit"
msgstr "Межа заряджання"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Припиняє заряджання на рівні %1%"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Не знайдено акумулятора з налаштовуваною межею заряджання"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "Stop charging at"
msgstr "Припиняти заряджання при"

#, kde-format
msgid "Tips"
msgstr "Поради"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "This update asks for your password once."
msgstr "Після цього оновлення потрібно буде ввести пароль один раз."

#, kde-format
msgid "The first change asks for your password once."
msgstr "Під час першої зміни потрібно буде ввести пароль один раз."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Якщо нова межа не діє, від’єднайте зарядний пристрій і під’єднайте його знову."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Щоб Межа заряджання завжди була видимою, клацніть правою кнопкою миші стрілку системного лотка, виберіть <b>Налаштувати системний лоток...</b> і встановіть для Межі заряджання значення <b>Завжди показувати</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Заряд акумулятора: %1%, заряджається"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Заряд акумулятора: %1%, розряджається"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Заряд акумулятора: %1%, повністю заряджено"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Заряд акумулятора: %1%, не заряджається"

#, kde-format
msgid "Battery at %1%"
msgstr "Заряд акумулятора: %1%"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Не вдалося прочитати межу заряджання."

#, kde-format
msgid "Could not change the charge limit."
msgstr "Не вдалося змінити межу заряджання."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Змінюйте межу заряджання акумулятора одним клацанням: 50, 80, 90 або 100%"
