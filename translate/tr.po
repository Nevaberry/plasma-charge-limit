#, kde-format
msgid "Charge Limit"
msgstr "Şarj Sınırı"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Şarjı %%1 düzeyinde durdurur"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Şarj sınırı ayarlanabilen bir pil bulunamadı"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%%1"

#, kde-format
msgid "Stop charging at"
msgstr "Şarjı şu düzeyde durdur"

#, kde-format
msgid "Tips"
msgstr "İpuçları"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%%1"

#, kde-format
msgid "This update asks for your password once."
msgstr "Bu güncelleme parolanızı bir kez sorar."

#, kde-format
msgid "The first change asks for your password once."
msgstr "İlk değişiklik parolanızı bir kez sorar."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Yeni sınır etkili olmazsa şarj aygıtının bağlantısını kesip yeniden bağlayın."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Şarj Sınırı’nın her zaman görünür olması için sistem tepsisi okuna sağ tıklayın, <b>Sistem Tepsisini Yapılandır...</b> seçeneğini seçin ve Şarj Sınırı’nı <b>Her zaman göster</b> olarak ayarlayın."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Pil %%1, şarj oluyor"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Pil %%1, boşalıyor"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Pil %%1, tamamen dolu"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Pil %%1, şarj olmuyor"

#, kde-format
msgid "Battery at %1%"
msgstr "Pil %%1"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Şarj sınırı okunamadı."

#. TRANSLATORS: %1 is a terminal command; do not translate pkexec.
#, kde-format
msgid "pkexec is missing. Install it with your package manager. On Debian, run: %1"
msgstr "pkexec eksik. Paket yöneticinizle yükleyin. Debian'da şu komutu çalıştırın: %1"

#, kde-format
msgid "Could not change the charge limit."
msgstr "Şarj sınırı değiştirilemedi."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Pil şarj sınırını tek tıklamayla yüzde 50, 80, 90 veya 100 olarak değiştirin"
