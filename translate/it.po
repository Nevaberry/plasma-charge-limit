#, kde-format
msgid "Charge Limit"
msgstr "Limite di carica"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Interrompe la carica al %1%"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Nessuna batteria con limite di carica regolabile trovata"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "Stop charging at"
msgstr "Interrompi la carica al"

#, kde-format
msgid "Tips"
msgstr "Suggerimenti"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "This update asks for your password once."
msgstr "Questo aggiornamento richiede la password una sola volta."

#, kde-format
msgid "The first change asks for your password once."
msgstr "La prima modifica richiede la password una sola volta."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Se un nuovo limite non ha effetto, scollega il caricabatterie e ricollegalo."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Per mantenere Limite di carica sempre visibile, fai clic con il tasto destro sulla freccia del vassoio di sistema, scegli <b>Configura il vassoio di sistema...</b> e imposta Limite di carica su <b>Sempre visibile</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Batteria al %1%, in carica"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Batteria al %1%, in scarica"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Batteria al %1%, completamente carica"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Batteria al %1%, non in carica"

#, kde-format
msgid "Battery at %1%"
msgstr "Batteria al %1%"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Impossibile leggere il limite di carica."

#, kde-format
msgid "Could not change the charge limit."
msgstr "Impossibile modificare il limite di carica."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Cambia il limite di carica della batteria con un clic: 50, 80, 90 o 100%"
