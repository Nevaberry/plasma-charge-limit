#, kde-format
msgid "Charge Limit"
msgstr "Limite de carga"

#, kde-format
msgid "Stops charging at %1%"
msgstr "Interrompe o carregamento em %1%"

#, kde-format
msgid "No battery with a charge limit found"
msgstr "Nenhuma bateria com limite de carga ajustável encontrada"

#, kde-format
msgctxt "charge limit on the panel icon"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "Stop charging at"
msgstr "Parar de carregar em"

#, kde-format
msgid "Tips"
msgstr "Dicas"

#, kde-format
msgctxt "charge limit preset"
msgid "%1%"
msgstr "%1%"

#, kde-format
msgid "This update asks for your password once."
msgstr "Esta atualização solicita sua senha uma única vez."

#, kde-format
msgid "The first change asks for your password once."
msgstr "A primeira alteração solicita sua senha uma única vez."

#, kde-format
msgid "If a new limit doesn't take effect, unplug the charger and plug it back in."
msgstr "Se um novo limite não tiver efeito, desconecte o carregador e conecte-o novamente."

#, kde-format
msgid "To keep Charge Limit always visible, right-click the system tray arrow, choose <b>Configure System Tray...</b>, and set Charge Limit to <b>Always show</b>."
msgstr "Para manter Limite de carga sempre visível, clique com o botão direito na seta da área de notificação, escolha <b>Configurar área de notificação...</b> e defina Limite de carga como <b>Sempre mostrar</b>."

#, kde-format
msgid "Battery at %1%, charging"
msgstr "Bateria em %1%, carregando"

#, kde-format
msgid "Battery at %1%, discharging"
msgstr "Bateria em %1%, descarregando"

#, kde-format
msgid "Battery at %1%, fully charged"
msgstr "Bateria em %1%, totalmente carregada"

#, kde-format
msgid "Battery at %1%, not charging"
msgstr "Bateria em %1%, sem carregar"

#, kde-format
msgid "Battery at %1%"
msgstr "Bateria em %1%"

#, kde-format
msgid "Could not read the charge limit."
msgstr "Não foi possível ler o limite de carga."

#, kde-format
msgid "Could not change the charge limit."
msgstr "Não foi possível alterar o limite de carga."

#, kde-format
msgid "Switch the battery charge limit with one click: 50, 80, 90 or 100%"
msgstr "Altere o limite de carga da bateria com um clique: 50, 80, 90 ou 100%"
